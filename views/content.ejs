<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Contoso Bank Content Portal</title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/brand.css">
  <link rel="stylesheet" href="/styles/content.css">
  <link rel="stylesheet" href="/styles/navigation.css">
  <link rel="stylesheet" href="/styles/sections.css">
</head>
<body>
  <div class="container">
    <!-- Header with Mega Menu -->
    <%- include('_header', { navigation: navigation, lang, langName, availableLanguages }) %>

    <div class="main-wrapper">
      <!-- Sidebar Navigation -->
      <aside class="sidebar">
        <nav class="main-menu">
          <!-- Main navigation links -->
        </nav>
      </aside>

      <!-- Main Content -->
      <main class="content">
        <!-- Breadcrumb -->
        <% if (breadcrumb && breadcrumb.length > 0) { %>
          <nav class="breadcrumb">
            <a href="/">Home</a>
            <% breadcrumb.forEach(crumb => { %>
              <span class="separator">/</span>
              <span><%= crumb %></span>
            <% }); %>
          </nav>
        <% } %>

        <!-- Page Title -->
        <article class="article">
          <div class="article-header">
            <h1 class="article-title"><%= title %></h1>
            
            <!-- AI Tools Bar -->
            <div class="ai-tools">
              <button id="summarizeBtn" class="ai-button" title="Generate AI summary of this article">
                ✨ Summarize with AI
              </button>
              <div class="audio-recap-group">
                <button id="audioRecapBtn" class="ai-button" title="Generate audio recap of this article">
                  🎵 Audio Recap
                </button>
                <div class="user-type-toggle" title="Switch between End User and Technical User views">
                  <input type="checkbox" id="userTypeToggle" class="toggle-checkbox">
                  <label for="userTypeToggle" class="toggle-label">
                    <span class="toggle-text-enduser">End User</span>
                    <span class="toggle-slider"></span>
                    <span class="toggle-text-technical">Technical</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- AI Summary Panel (Hidden by default) -->
            <div id="summaryPanel" class="ai-panel" style="display: none;">
              <div class="ai-panel-header">
                <h3>AI Summary</h3>
                <button class="close-btn" onclick="document.getElementById('summaryPanel').style.display='none'">✕</button>
              </div>
              <div id="summaryContent" class="ai-panel-content">
                <p>Loading summary...</p>
              </div>
            </div>

            <!-- Audio Recap Panel (Hidden by default) -->
            <div id="audioPanel" class="ai-panel" style="display: none;">
              <div class="ai-panel-header">
                <h3>Audio Recap</h3>
                <button class="close-btn" onclick="document.getElementById('audioPanel').style.display='none'">✕</button>
              </div>
              <div id="audioContent" class="ai-panel-content">
                <p>Generating audio...</p>
                <audio id="audioPlayer" controls style="width: 100%; margin-top: 10px;"></audio>
              </div>
            </div>
          </div>
          
          <!-- Article Content -->
          <div class="article-body">
            <%- html %>
          </div>

          <!-- Article Footer -->
          <footer class="article-footer">
            <p class="last-updated">Last updated: <%= new Date().toLocaleDateString() %></p>
          </footer>
        </article>
      </main>
    </div>

    <!-- Footer -->
    <%- include('_footer') %>
  </div>

  <script src="/scripts/main.js"></script>
  <script src="/scripts/navigation.js"></script>
  <script>
    // Set language for AI features
    const currentLang = '<%= lang %>';
    const currentPath = '<%= typeof filePath !== "undefined" ? filePath : "" %>';
    
    // Only show toggle for quarterly bulletin pages
    const userTypeToggle = document.getElementById('userTypeToggle');
    if (userTypeToggle) {
      // Toggle is only present in views where it's needed
      userTypeToggle.style.display = 'inline-flex';
    }
    
    // Summarize with AI
    document.getElementById('summarizeBtn').addEventListener('click', async function() {
      const content = document.querySelector('.article-body').innerText;
      const summaryPanel = document.getElementById('summaryPanel');
      const summaryContent = document.getElementById('summaryContent');
      
      summaryPanel.style.display = 'block';
      summaryContent.innerHTML = '<p>Generating summary...</p>';
      
      try {
        const response = await fetch('/api/summarize', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, language: currentLang })
        });
        
        const data = await response.json();
        summaryContent.innerHTML = '<p>' + data.summary + '</p>';
      } catch (error) {
        summaryContent.innerHTML = '<p style="color: red;">Error generating summary: ' + error.message + '</p>';
      }
    });
    
    // Audio Recap
    document.getElementById('audioRecapBtn').addEventListener('click', async function() {
      const content = document.querySelector('.article-body').innerText;
      const audioPanel = document.getElementById('audioPanel');
      const audioContent = document.getElementById('audioContent');
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const currentLangCode = (pathParts[1] || currentLang || 'EN').toUpperCase();
      const rawSlug = decodeURIComponent((pathParts[pathParts.length - 1] || '').split(/[?#]/)[0]);
      const urlSlug = rawSlug.replace(/\.md$/i, '').toLowerCase();
      const activeSlug = String(window.__loadedMarkdownSlug || urlSlug).replace(/\.md$/i, '').toLowerCase();

      function getAudioFileCandidates(slug) {
        const sanitizedSlug = String(slug || '').toLowerCase();
        const slugCandidates = [sanitizedSlug];

        // Fallback to end-user audio when the technical variant has no dedicated narration.
        if (sanitizedSlug.endsWith('-economist')) {
          slugCandidates.push(sanitizedSlug.replace(/-economist$/, '-enduser'));
        }

        if (sanitizedSlug === 'quarterly-bulletin-q4-2025') {
          slugCandidates.push('quarterly-bulletin-q4-2025-enduser');
        }

        const fileCandidates = [];
        for (const candidateSlug of slugCandidates) {
          fileCandidates.push(candidateSlug + '-Audio.wav');
          fileCandidates.push(candidateSlug + '-audio.wav');
        }

        return fileCandidates;
      }
      
      audioPanel.style.display = 'block';
      audioContent.innerHTML = '<p>Generating audio recap...</p><audio id="audioPlayer" controls style="width: 100%; margin-top: 10px;"></audio>';

      // Use pre-generated narration when available for this article.
      const audioFileCandidates = getAudioFileCandidates(activeSlug);
      for (const audioFile of audioFileCandidates) {
        const encodedAudioFile = encodeURIComponent(audioFile);
        const primaryAudioUrl = '/content-audio/' + currentLangCode + '/' + encodedAudioFile;
        const fallbackAudioUrl = '/content-audio/EN/' + encodedAudioFile;

        let resolvedAudioUrl = '';
        try {
          const primaryCheck = await fetch(primaryAudioUrl, { method: 'HEAD' });
          if (primaryCheck.ok) {
            resolvedAudioUrl = primaryAudioUrl;
          } else {
            const fallbackCheck = await fetch(fallbackAudioUrl, { method: 'HEAD' });
            if (fallbackCheck.ok) {
              resolvedAudioUrl = fallbackAudioUrl;
            }
          }
        } catch (checkError) {
          // If availability checks fail, continue to API fallback below.
        }

        if (resolvedAudioUrl) {
          audioContent.innerHTML = '<p>Audio recap ready</p><audio id="audioPlayer" controls style="width: 100%; margin-top: 10px;"></audio>';
          const audioPlayer = document.getElementById('audioPlayer');
          audioPlayer.src = resolvedAudioUrl;
          audioPlayer.load();
          return;
        }
      }
      
      try {
        const response = await fetch('/api/audio-recap', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text: content,
            language: currentLang,
            pagePath: window.location.pathname
          })
        });
        
        const data = await response.json();
        if (data && data.audioUrl) {
          audioContent.innerHTML = '<p>Audio recap ready</p><audio id="audioPlayer" controls style="width: 100%; margin-top: 10px;"></audio>';
          const audioPlayer = document.getElementById('audioPlayer');
          audioPlayer.src = data.audioUrl;
          audioPlayer.load();
        } else {
          audioContent.innerHTML = '<p style="color: #666;">Audio recap is not available for this article yet.</p><audio id="audioPlayer" controls style="width: 100%; margin-top: 10px;"></audio>';
        }
      } catch (error) {
        audioContent.innerHTML = '<p style="color: red;">Error generating audio: ' + error.message + '</p><audio id="audioPlayer" controls style="width: 100%; margin-top: 10px;"></audio>';
      }
    });
  </script>
</body>
</html>

