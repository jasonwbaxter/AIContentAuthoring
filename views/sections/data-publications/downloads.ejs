<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Central Bank</title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/brand.css">
  <link rel="stylesheet" href="/styles/navigation.css">
  <link rel="stylesheet" href="/styles/sections.css">
</head>
<body>
  <div class="container">
    <!-- Header -->
    <%- include('../../_header', { navigation: navigation, lang, langName, availableLanguages }) %>

    <div class="main-wrapper">
      <!-- Main Content -->
      <main class="content full-width">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="separator">/</span>
          <a href="/data-publications">Data & Publications</a>
          <span class="separator">/</span>
          <span aria-current="page">Download Centre</span>
        </nav>

        <!-- Page Header -->
        <div class="section-hero">
          <h1>Download Centre</h1>
          <p>Download publications, datasets, and statistical tables</p>
        </div>

        <!-- Placeholder Content -->
        <section class="content-section">
          <h2>Available Downloads</h2>
          <p>
            The Download Centre provides easy access to all Central Bank publications and datasets
            in multiple formats (PDF, CSV, JSON, XLSX).
          </p>
          <p>
            <strong>Coming soon:</strong> Enhanced download interface with advanced filtering,
            bulk download options, and API access to datasets.
          </p>
        </section>
      </main>
    </div>

    <!-- Footer -->
    <%- include('../../_footer') %>
  </div>

  <script src="/scripts/main.js"></script>
  <script src="/scripts/navigation.js"></script>
</body>
</html>
