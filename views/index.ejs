<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Contoso Bank</title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/brand.css">
  <link rel="stylesheet" href="/styles/navigation.css">
  <style>
    /* Homepage Specific Styles */
    .sidebar { display: none; }
    .main-wrapper { width: 100%; }
    .content { width: 100%; padding: 0; }

    /* Hero Section */
    .hero-banner {
      background: linear-gradient(135deg, #0078d4 0%, #107c10 100%);
      color: white;
      padding: 80px 40px;
      text-align: center;
      margin-bottom: 60px;
      border-radius: 8px;
      margin: 0 20px 60px 20px;
    }

    .hero-banner h1 {
      font-size: 48px;
      margin-bottom: 20px;
      font-weight: 700;
    }

    .hero-banner .tagline {
      font-size: 20px;
      opacity: 0.95;
      margin-bottom: 40px;
    }

    /* Quick Stats */
    .quick-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin: 0 20px 60px 20px;
    }

    .stat-card {
      background: white;
      padding: 30px;
      border-radius: 8px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      border-left: 4px solid #0078d4;
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }

    .stat-value {
      font-size: 32px;
      font-weight: 700;
      color: #0078d4;
      margin-bottom: 10px;
    }

    .stat-label {
      font-size: 14px;
      color: #666;
      font-weight: 500;
    }

    .stat-unit {
      font-size: 12px;
      color: #999;
    }

    /* Featured News Section */
    .featured-news {
      margin: 0 20px 60px 20px;
    }

    .section-title {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 30px;
      color: #333;
      border-bottom: 3px solid #0078d4;
      padding-bottom: 15px;
    }

    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      margin-bottom: 60px;
    }

    .news-card {
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
    }

    .news-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .news-card-header {
      background: linear-gradient(135deg, #0078d4 0%, #107c10 100%);
      color: white;
      padding: 20px;
      min-height: 80px;
      display: flex;
      align-items: flex-start;
    }

    .news-card-icon {
      font-size: 32px;
      margin-right: 15px;
      flex-shrink: 0;
    }

    .news-card-title {
      font-size: 18px;
      font-weight: 600;
      color: white;
    }

    .news-card-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .news-card-excerpt {
      color: #666;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 20px;
      flex: 1;
    }

    .news-card-date {
      font-size: 12px;
      color: #999;
      margin-bottom: 15px;
    }

    .news-card-link {
      display: inline-block;
      color: #0078d4;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.3s ease;
    }

    .news-card-link:hover {
      color: #107c10;
      text-decoration: underline;
    }

    /* Highlight Section */
    .highlights {
      background: #f5f5f5;
      padding: 40px;
      border-radius: 8px;
      margin: 0 20px 60px 20px;
    }

    .highlight-item {
      background: white;
      padding: 20px;
      margin-bottom: 15px;
      border-left: 4px solid #107c10;
      border-radius: 4px;
    }

    .highlight-item:last-child {
      margin-bottom: 0;
    }

    .highlight-title {
      font-weight: 600;
      color: #333;
      margin-bottom: 8px;
    }

    .highlight-text {
      font-size: 14px;
      color: #666;
      line-height: 1.6;
    }

    /* Quick Links Section */
    .quick-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin: 0 20px 60px 20px;
    }

    .quick-link-card {
      background: white;
      padding: 30px;
      border-radius: 8px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
      text-decoration: none;
      color: inherit;
      border: 2px solid transparent;
    }

    .quick-link-card:hover {
      border-color: #0078d4;
      transform: translateY(-4px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }

    .quick-link-icon {
      font-size: 48px;
      margin-bottom: 15px;
      display: block;
    }

    .quick-link-title {
      font-weight: 600;
      font-size: 16px;
      color: #333;
    }

    /* Announcement Banner */
    .announcement-banner {
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      padding: 20px;
      margin: 0 20px 30px 20px;
      border-radius: 4px;
    }

    .announcement-banner strong {
      color: #856404;
    }

    .announcement-banner p {
      margin: 0;
      color: #856404;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <%- include('_header', { navigation: navigation, lang, langName, availableLanguages }) %>

    <div class="main-wrapper">
      <main class="content">
        <!-- Hero Banner -->
        <div class="hero-banner">
          <h1>Welcome to Contoso Bank</h1>
          <p class="tagline">Your trusted source for monetary policy, economic data, and financial information</p>
        </div>

        <!-- Announcement -->
        <div class="announcement-banner">
          <p><strong>📢 Important Notice:</strong> Monetary Policy Committee announcement scheduled for February 6, 2026. Visit our news section for updates.</p>
        </div>

        <!-- Key Economic Indicators -->
        <div class="featured-news">
          <h2 class="section-title">Key Economic Indicators</h2>
          <div class="quick-stats">
            <div class="stat-card">
              <div class="stat-value">6.5%</div>
              <div class="stat-label">Inflation Rate</div>
              <div class="stat-unit">Year-over-Year</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">8.25%</div>
              <div class="stat-label">Repo Rate</div>
              <div class="stat-unit">Current</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">17.85</div>
              <div class="stat-label">USD/ZAR Exchange</div>
              <div class="stat-unit">Current Rate</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">4.2%</div>
              <div class="stat-label">Producer Prices</div>
              <div class="stat-unit">Year-over-Year</div>
            </div>
          </div>
        </div>

        <!-- Featured News -->
        <div class="featured-news">
          <h2 class="section-title">Latest News & Updates</h2>
          <div class="news-grid">
            <div class="news-card">
              <div class="news-card-header">
                <span class="news-card-icon">📊</span>
                <div class="news-card-title">Monetary Policy Decision</div>
              </div>
              <div class="news-card-body">
                <div class="news-card-date">Updated: January 29, 2026</div>
                <div class="news-card-excerpt">
                  The Monetary Policy Committee has maintained the Repo Rate at 8.25% per annum. This decision reflects the bank's commitment to achieving and maintaining price stability while supporting economic growth.
                </div>
                <a href="/news/speeches/" class="news-card-link">Read Full Statement →</a>
              </div>
            </div>

            <div class="news-card">
              <div class="news-card-header">
                <span class="news-card-icon">📈</span>
                <div class="news-card-title">Financial Stability Report</div>
              </div>
              <div class="news-card-body">
                <div class="news-card-date">Published: January 25, 2026</div>
                <div class="news-card-excerpt">
                  The latest Financial Stability Review shows resilient banking sector performance with improved capital ratios and asset quality. Download the full report from our Data & Publications section.
                </div>
                <a href="/data-publications/publications/" class="news-card-link">View Publications →</a>
              </div>
            </div>

            <div class="news-card">
              <div class="news-card-header">
                <span class="news-card-icon">📰</span>
                <div class="news-card-title">Economic Outlook 2026</div>
              </div>
              <div class="news-card-body">
                <div class="news-card-date">Published: January 20, 2026</div>
                <div class="news-card-excerpt">
                  Our latest economic outlook provides comprehensive analysis of growth trends, inflation expectations, and monetary policy implications for the coming year. Access all economic forecasts here.
                </div>
                <a href="/data-publications/data-hub/" class="news-card-link">Explore Data Hub →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Important Highlights -->
        <div class="highlights">
          <h2 class="section-title">Important Updates & Notices</h2>
          <div class="highlight-item">
            <div class="highlight-title">🔔 System Maintenance Alert</div>
            <div class="highlight-text">
              Our data portal will be undergoing scheduled maintenance on February 1-2, 2026. We apologize for any inconvenience. All services will be restored by February 3, 2026.
            </div>
          </div>
          <div class="highlight-item">
            <div class="highlight-title">📋 New Submission Guidelines</div>
            <div class="highlight-text">
              Updated guidelines for PAIA (Promotion of Access to Information Act) requests are now available. Please review our policies & compliance section for detailed procedures.
            </div>
          </div>
          <div class="highlight-item">
            <div class="highlight-title">🏦 Banking Sector Developments</div>
            <div class="highlight-text">
              Recent regulatory updates and banking sector developments are summarized in our latest market operations report. Check our publications for more details.
            </div>
          </div>
        </div>

        <!-- Quick Access Links -->
        <div class="featured-news">
          <h2 class="section-title">Quick Access</h2>
          <div class="quick-links">
            <a href="/about/" class="quick-link-card">
              <span class="quick-link-icon">🏛️</span>
              <div class="quick-link-title">About Us</div>
            </a>
            <a href="/data-publications/" class="quick-link-card">
              <span class="quick-link-icon">📊</span>
              <div class="quick-link-title">Data & Publications</div>
            </a>
            <a href="/policy-markets/" class="quick-link-card">
              <span class="quick-link-icon">💼</span>
              <div class="quick-link-title">Monetary Policy</div>
            </a>
            <a href="/news/" class="quick-link-card">
              <span class="quick-link-icon">📰</span>
              <div class="quick-link-title">News & Media</div>
            </a>
            <a href="/help-contact/" class="quick-link-card">
              <span class="quick-link-icon">📞</span>
              <div class="quick-link-title">Contact Us</div>
            </a>
            <a href="/data-publications/indicators/" class="quick-link-card">
              <span class="quick-link-icon">📈</span>
              <div class="quick-link-title">Live Indicators</div>
            </a>
          </div>
        </div>
      </main>
    </div>

    <%- include('_footer') %>
  </div>

  <script src="/scripts/main.js"></script>
  <script src="/scripts/navigation.js"></script>
</body>
</html>
